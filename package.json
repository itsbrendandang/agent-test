{
  "name": "glhf",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "setup": "npm --prefix engine install && npm --prefix dashboard install && (cd glhf/bixbench && uv sync --locked)",
    "engine": "node engine/src/server.ts",
    "board": "node engine/src/cli.ts run",
    "resume": "node engine/src/cli.ts resume",
    "runs": "node engine/src/cli.ts list",
    "glhf": "node engine/src/glhf/cli.ts",
    "doctor": "node engine/src/glhf/cli.ts doctor",
    "demo": "node engine/src/glhf/cli.ts demo",
    "scoreboard": "node engine/src/glhf/cli.ts scoreboard",
    "dashboard": "npm --prefix dashboard run dev",
    "desktop": "npm --prefix dashboard run desktop",
    "typecheck": "(cd engine && npx tsc --noEmit) && (cd dashboard && npx tsc -b)",
    "test:engine": "npm --prefix engine test",
    "test": "(cd glhf/bixbench && uv run pytest -q tests) && npm run typecheck && npm run test:engine",
    "docker": "docker compose up --build"
  }
}
