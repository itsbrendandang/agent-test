# Copy to .env and fill in what you have. This file is gitignored; never commit keys.
# Put comments on their own lines, not after a value.

# --- GLHF swarm (BixBench3) ---
# Agents. Any Inspect provider works; set the key for each provider you use.
ANTHROPIC_API_KEY=
# Required for cloud runs: the benchmark's judge and network gate use GPT-5.5. Also an agent provider.
OPENAI_API_KEY=
# Access to the gated dataset EdisonScientific/BixBench3 (cloud runs).
HF_TOKEN=

# Long-term memory for the swarm (past.dev). Optional: without it, memory is glhf/memory/lessons.md.
PAST_API_KEY=

# --- Drug board ---
# Every board model and Jev (typesafe/jev-1.14). Without it the board runs on scripted mock models.
OPENROUTER_API_KEY=
# Exa search: board literature search and the swarm's --exa documentation search (dashboard.exa.ai).
EXA_API_KEY=
# Optional: call Jev directly instead of through OpenRouter.
TYPESAFE_API_KEY=

# --- Options ---
# Force mock models even with keys set.
# DRUG_BOARD_MOCK=1
# DRUG_BOARD_PORT=8787
