# Copy this file to .env and fill in the keys you have. .env is not in git. Never commit a key.
# This file (.env.example) is in git: keep it without real values.
# Full reference: docs/configuration.md
# Put comments on their own lines, not after a value.

# --- Paid calls ---
# Kill switch: paid calls (real models, Exa, checkers, cloud runs) are refused unless this is exactly 0.
# NO_PAID_CALLS=0
# The engine also has a runtime paid switch (POST /api/paid, the dashboard's switch). It changes the state for the running
# engine process only; a restart goes back to the line above. 1 locks it, so only this file can turn paid calls on.
# CI and `npm test` set it. Leave it unset for normal use, or set 1 on a shared machine.
# PAID_SWITCH_LOCKED=1
# Direct answers on the Research screen in Real mode (POST /api/research). Off unless this is exactly 1: without it, a
# question on the Research screen gets a plan for a team review instead of an answer. Demo answers need no switch.
# The engine says which at start-up, `npm start` repeats it, and GET /api/status reports it (researchPreview, directAnswers).
# Each answer calls paid models, up to its cap (research in board/config.yaml). See docs/research-answer.md.
# RESEARCH_PREVIEW=1

# --- Local model (Ollama on this machine): free, private, allowed while paid calls are off ---
# Needs no key. Model ids are ollama/<name>, for example ollama/qwen2.5:14b. See docs/local-model.md.
# Where the server is. Default http://127.0.0.1:11434. It must be this machine (localhost, 127.x.x.x, ::1).
# LOCAL_MODEL_URL=http://127.0.0.1:11434
# A server on another machine is refused unless this is exactly 1. Set it only for a host you own, reached over
# a private network: Ollama has no authentication, and what is sent there leaves this machine.
# LOCAL_MODEL_ALLOW_REMOTE=1
# Drug board: run every agent on a local model instead of scripted turns. An id (ollama/qwen2.5:14b), or 1 to
# use local_models in board/config.yaml. Search and the checkers stay scripted, so nothing is fact-checked.
# DRUG_BOARD_LOCAL_MODEL=ollama/qwen2.5:14b

# --- GLHF swarm (BixBench3) ---
# Agents. Any Inspect provider works; set the key for each provider you use.
# ANTHROPIC_API_KEY is also used by the Ask box in the dashboard.
ANTHROPIC_API_KEY=
# Required for cloud runs: the benchmark's judge and network gate use GPT-5.5. Also an agent provider.
OPENAI_API_KEY=
# Access to the gated dataset EdisonScientific/BixBench3 (cloud runs).
HF_TOKEN=

# Long-term memory for the swarm (past.dev), used by runs with --memory.
# Optional: without it, runs read the approved file glhf/memory/lessons.md.
# A run only queues lessons in glhf/memory/lessons.pending.md. A person approves them.
# Lessons are sent to past.dev only when they are approved. See glhf/memory/README.md.
PAST_API_KEY=

# --- Drug board ---
# The board calls Anthropic and OpenAI directly: ANTHROPIC_API_KEY and OPENAI_API_KEY above. A real board run
# (NO_PAID_CALLS=0) needs the key of every tier in board/config.yaml and is refused at its start, naming the
# tier and the key, when one is missing. It is never silently made scripted. Without paid calls it runs scripted.
# Exa search: the swarm's --exa documentation search, and the board's literature search for any member that has
# the search tool (none today). The engine counts what it spends on Exa and stops at meeting.exa_ceiling_usd.
EXA_API_KEY=

# --- Options ---
# Force scripted (mock) models for the drug board even with keys set.
# DRUG_BOARD_MOCK=1
# Engine port (default 8787). The CLI uses the same variable to find the engine.
# DRUG_BOARD_PORT=8787
# Address the engine listens on (default 127.0.0.1). Docker Compose sets 0.0.0.0 inside the container.
# HOST=127.0.0.1
# Extra browser origins that may call the engine, separated by commas (default: the dashboard on port 5317).
# DASHBOARD_ORIGINS=http://localhost:3000
# Extra host names the engine answers to, separated by commas (default: localhost, 127.0.0.1, [::1]).
# ENGINE_HOSTS=my-machine.local
# Model for the Ask box in the dashboard (default claude-haiku-5-5).
# ASK_MODEL=claude-haiku-5-5

# --- Database (optional): a copy of the records in Supabase. See docs/database.md ---
# Off unless both are set. The local files under board/runs/ stay the source of truth.
# The service role key is used by the engine only. Never commit it.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- Run tracker (rarely needed) ---
# Time a local run may go past its time limit before the tracker stops it, in milliseconds.
# Default: 30 minutes, or a quarter of the time limit if that is more.
# GLHF_LOCAL_MARGIN_MS=1800000
# Time `bixbench3 run` may take to launch a cloud run before it counts as stuck (default 2 hours).
# GLHF_LAUNCH_TIMEOUT_MS=7200000

# --- Hosted open models for the BixBench v1 grid (glhf/openmodels/models.yaml). Optional. ---
# Tinker (Thinking Machines), OpenAI-compatible inference. Inspect id: openai-api/tinker/<model>.
# The address has a default in models.yaml; set it only to override. Never run by an agent.
TINKER_API_KEY=
# TINKER_BASE_URL=https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1
# Moonshot's own API for Kimi. Inspect id: openai-api/moonshot/<model>.
MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
