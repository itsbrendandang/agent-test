# Copy to .env. With no OPENROUTER_API_KEY the board runs on scripted mock models.
OPENROUTER_API_KEY=      # required for live runs: every board model + Jev (typesafe/jev-1.14)
EXA_API_KEY=             # literature search (dashboard.exa.ai)
OPENAI_API_KEY=          # optional: escalation checker for contested literature claims
TYPESAFE_API_KEY=        # optional: call Jev directly instead of through OpenRouter
# DRUG_BOARD_MOCK=1      # force mock models even with keys set
# DRUG_BOARD_PORT=8787
